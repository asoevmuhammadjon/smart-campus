@startuml
left to right direction
skinparam packageStyle rectangle

actor "Student" as Student
actor "Facilities Admin" as Admin

rectangle "Smart Campus Study Room Booking System" {
  use-case "Browse Available Rooms" as UC1
  use-case "Book Study Room" as UC2
  use-case "Cancel Booking" as UC3
  use-case "View Bookings" as UC4
  use-case "Check-in via QR Code" as UC5
  use-case "Manage Room Availability" as UC6
  use-case "Generate Utilization Reports" as UC7
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5

Admin --> UC6
Admin --> UC7

UC2 .> UC1 : <<include>>
@enduml
